  "cards": [
    {
      "dot": "cyan",
      "title": "One session, several repos",
      "items": [
        "The agent's working directory is the home repo, where you would start Claude by hand.",
        "Every other repo is a worktree in the session folder, on the same branch name.",
        "A repo can be attached at start, by you mid-session, or by the agent when it finds it needs one."
      ]
    },
    {
      "dot": "violet",
      "title": "Everything is an event",
      "items": [
        "Spawns, messages, tool calls and file changes are all appended to the session log.",
        "Each event names its parent, so the graph and the timeline are replays of the log.",
        "A client that reconnects asks for events after its last sequence number."
      ]
    },
    {
      "dot": "amber",
      "title": "Delegation stays visible",
      "items": [
        "A child is a session of its own, nested under its parent.",
        "Its report lands in the parent agent's conversation.",
        "Nothing merges on its own: the session ends at review."
      ]
    }
  ]
}