# Calin's public-mode settings (docs/specs/2026-11-27-remote-access.md, section 2),
# read by systemd through EnvironmentFile= in calin.service.
# This file is where the client secret goes when there is one: keep it owned by root
# with mode 0600 and never share it.
CALIN_PUBLIC_URL=https://calin.example.com
CALIN_OIDC_ISSUER=https://example.eu.auth0.com/
CALIN_OIDC_CLIENT_ID=Xq3BfZ9kLmN0pRsT
CALIN_ALLOWED_USERS=owner@example.com
