# Calin's public-mode settings (docs/specs/2026-11-27-remote-access.md, section 2),
# read by systemd through EnvironmentFile= in calin.service.
# This file holds a secret, the OpenID Connect client secret: keep it owned by root
# with mode 0600 and never share it.
CALIN_PUBLIC_URL=https://agents.dev-box.example.org
CALIN_OIDC_ISSUER=https://login.example.org:8443/realms/main
CALIN_OIDC_CLIENT_ID="calin client"
CALIN_OIDC_CLIENT_SECRET="s3cr\"et \$HOME 'x' \\ #1"
CALIN_ALLOWED_USERS=Owner.Name+calin@example.org,sub:auth0|5f1e2d3c
